<krpano title="Virtual Tour" showlog="false" logkey="false" showerrors="false" onstart="startup">

	<action name="startup" autorun="onstart">
		set("autorotate.enabled",false);
		set(org_vlookat,0);
		set(org_hlookat,0);
		set(count,0);
		if(startscene === null OR !scene[get(startscene)], copy(startscene,scene[0].name); );
		loadscene(get(startscene), null, MERGE);
		if(startactions !== null, startactions() );
	</action>

	<action name="calcHotspotPos">
		div(hfov,%1,57.295779);
		div(yaw,%2,-57.295779);
		div(pitch,%3,57.295779);
		div(roll,%4,-57.295779);
		mul(hfov,0.5);Math.tan(hfov);mul(width,hfov,1000);set(height,'prop');
		Math.cos(ch,yaw);Math.sin(sh,yaw);
		Math.cos(ca,pitch);Math.sin(sa,pitch);
		Math.cos(cb,roll);Math.sin(sb,roll);
		mul(m0,ca,ch);
		mul(tmp,cb,sa);mul(tmp,ch);mul(tmp2,sb,sh);add(m3,tmp,tmp2);
		mul(m4,cb,ca);
		mul(tmp,cb,sa);mul(tmp,sh);mul(tmp2,sb,ch);sub(m5n,tmp,tmp2);mul(m5n,-1);
		mul(tmp,sb,sa);mul(tmp,ch);mul(tmp2,cb,sh);sub(m6n,tmp,tmp2);mul(m6n,-1);
		Math.atan2(yaw,m6n,m0);
		Math.atan2(roll,m5n,m4);
		Math.asin(pitch,m3);
		mul(ath,yaw,57.295779);
		mul(atv,pitch,57.295779);
		mul(rotate,roll,57.295779);
	</action>

	<!-- hotspot[op_%1].addevent("onloaded", "delayedcall(0.1,set(hotspot[thumb_%1].visible,false);set(hotspot[op_%1].alpha,1););"); -->
	<action name="setOptionHotspotVisible">
		if(hotspot[op_%1] !== null AND hotspot[thumb_%1] !== null,
		if(%2,
		if(hotspot[op_%1].loaded,
		set(hotspot[op_%1].visible,true);
		set(hotspot[thumb_%1].visible,false);
		,
		set(hotspot[thumb_%1].visible,true);
		set(hotspot[thumb_%1].alpha,1);
		set(hotspot[op_%1].visible,true);
		set(hotspot[op_%1].alpha,0);
		hotspot[op_%1].addevent("onloaded", "delayVisible(%1);");
		);
		,
		set(hotspot[op_%1].visible,false);
		set(hotspot[thumb_%1].visible,false);
		);
		,
		set(hotspot[op_%1].visible,%2);
		if(hotspot[op_%1_p1] !== null, set(hotspot[op_%1_p1].visible,%2););
		if(hotspot[op_%1_p2] !== null, set(hotspot[op_%1_p2].visible,%2););
		);
	</action>

	<!-- 防止显示的时候跳一下 -->
	<action name="delayVisible">
		set(hotspot[op_%1].visible,true);
		set(hotspot[op_%1].alpha,0);
		set(hotspot[fix_%1].visible,true);
		set(hotspot[fix_%1].alpha,0);
		delayedcall(0.1,
		set(hotspot[thumb_%1].visible,false);
		set(hotspot[op_%1].alpha,1);
		set(hotspot[fix_%1].alpha,1);
		);
	</action>

